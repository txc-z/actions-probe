@@ -0,0 +1,67 @@
+package org.telegram.messenger.forkgram
+
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.tgnet.TLRPC
+
+/**
+ * Android counterpart of the desktop forkgram/filter_utils.h from
+ * forkgram/tdesktop PR #183 ("Hide msg in group from blocked users").
+ *
+ * Checks if a message is from a blocked user. Used to hide messages
+ * from blocked users in group chats. Does NOT hide messages in the
+ * blocked user's own chat dialog.
+ */
+object FilterUtils {
+
+    const val PREF_HIDE_FROM_BLOCKED_USERS = "hideFromBlockedUsers"
+
+    @JvmStatic
+    fun isFromBlockedUser(currentAccount: Int, messageObject: MessageObject?): Boolean {
+        if (messageObject == null || messageObject.messageOwner == null) {
+            return false
+        }
+        // Check if the feature is enabled.
+        if (!MessagesController.getGlobalMainSettings().getBoolean(PREF_HIDE_FROM_BLOCKED_USERS, false)) {
+            return false
+        }
+
+        // Don't hide our own messages.
+        if (messageObject.isOut) {
+            return false
+        }
+
+        val message = messageObject.messageOwner
+
+        // Don't hide messages in the blocked user's own chat.
+        // Otherwise the dialog would be empty.
+        val fromId = message.from_id
+        if (fromId is TLRPC.TL_peerUser && fromId.user_id != 0L &&
+            fromId.user_id == messageObject.dialogId
+        ) {
+            return false
+        }
+
+        val controller = MessagesController.getInstance(currentAccount)
+
+        // Check if the sender is blocked.
+        if (fromId is TLRPC.TL_peerUser && fromId.user_id != 0L &&
+            controller.blockePeers.indexOfKey(fromId.user_id) >= 0
+        ) {
+            return true
+        }
+
+        // For forwarded messages, check the original sender.
+        val fwdFrom = message.fwd_from
+        if (fwdFrom != null) {
+            val originalId = fwdFrom.from_id
+            if (originalId is TLRPC.TL_peerUser && originalId.user_id != 0L &&
+                controller.blockePeers.indexOfKey(originalId.user_id) >= 0
+            ) {
+                return true
+            }
+        }
+
+        return false
+    }
+}
